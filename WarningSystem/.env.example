# OpenAQ API Configuration
# Get your API key from: https://openaq.org/
OPENAQ_API_KEY=your_api_key_here

# Sentinel Hub API Configuration
# Sign up at: https://www.sentinel-hub.com/
# Create an OAuth client to get credentials
SENTINEL_CLIENT_ID=your_sentinel_client_id_here
SENTINEL_CLIENT_SECRET=your_sentinel_client_secret_here
